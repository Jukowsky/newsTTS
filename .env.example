# Copy this to .env and fill in values before deploying

# Required — change this from the default
ADMIN_PASSWORD=change-me-to-something-strong

# Optional — override defaults
SCRAPE_HOUR=3
SCRAPE_MINUTE=0
CLEANUP_HOUR=2
CLEANUP_MINUTE=0
AUDIO_RETENTION_HOURS=24
MAX_ARTICLES_PER_PORTAL=10

# TTS API keys are stored per-portal in the DB via the Admin UI.
# You do NOT need to set them here — configure them after deploy at /admin
